#!/usr/bin/env python3
"""table-talk: record actions, background tasks, technical terms, and mermaid
diagrams for the table-talk reply protocol. Stdlib only — recording must never
need the network. View: `table-talk serve`; `table-talk url` says where."""
import argparse
import fcntl
import glob
import json
import os
import re
import secrets
import shutil
import sys
import time
from contextlib import contextmanager
from pathlib import Path

DATA_DIR = Path(os.environ.get("TABLE_TALK_DIR") or str(Path.home() / ".local/share/table-talk"))


def fold(path):
    """Current state of one file: shallow-merge events by id, in file order.
    Contract shared with table-talk-dash.py; both selftests pin it."""
    state = {}
    try:
        raw = path.read_bytes()
    except OSError:
        # OSError, not FileNotFoundError: all_ids() folds EVERY file in the data
        # dir on every record, so one unreadable log (chmod, stale mount) or a
        # directory named *.jsonl made `table-talk task ...` die with a raw
        # traceback instead of recording.
        return state
    for n, line in enumerate(raw.splitlines(), 1):
        if not line.strip():
            continue
        try:
            ev = json.loads(line.decode("utf-8"))
            eid = str(ev["id"])
            state[eid] = {**state.get(eid, {}), **ev}
        except (UnicodeDecodeError, json.JSONDecodeError, TypeError, KeyError):
            print(f"warning: skipped malformed line {path.name}:{n}", file=sys.stderr)
    return state


def safe_project(project):
    """A project name becomes a filename component; keep path separators out of it."""
    return re.sub(r"[/\\\x00]", "_", project or Path.cwd().name)


def session_file(project=None):
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        p = DATA_DIR / f"{time.strftime('%Y-%m-%d')}-{safe_project(project)}.jsonl"
        p.touch()
    except OSError as e:
        sys.exit(f"error: cannot write to data dir {DATA_DIR}: {e}")
    return p


def scrub(s):
    """A value that is not valid UTF-8, made writable.

    argv decodes bytes it cannot decode with surrogateescape, so a value piped
    in from another tool - `table-talk progress $id "$(tail -1 train.log)"` -
    can carry lone surrogates. stdlib json writes them without complaint, and
    the dashboard then cannot render AT ALL: NiceGUI hard-requires orjson as
    its socket serialiser and orjson refuses the whole payload, so one stray
    byte in one field stops the page instead of spoiling one cell.

    Escaped at the write boundary, where the damage is one token instead of one
    product. backslashreplace rather than replace: `\\udcfe` still says WHICH
    byte would not decode (0xfe), so the line stays diagnosable, where '?' and
    U+FFFD both throw that away.
    """
    return s.encode("utf-8", "backslashreplace").decode("utf-8") if isinstance(s, str) else s


def append(path, ev):
    with open(path, "a") as f:
        f.write(json.dumps({k: scrub(v) for k, v in ev.items()}) + "\n")


def all_ids():
    """Every id in use across the whole data dir — new ids must avoid all of them."""
    used = set()
    for p in DATA_DIR.glob("*.jsonl"):
        used |= fold(p).keys()
    return used


def new_id():
    used = all_ids()
    while (i := secrets.token_hex(2)) in used:
        pass
    return i


@contextmanager
def mint_lock():
    """Serialize fold+mint+append so concurrent CLIs can't pick or splice the same id."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(DATA_DIR / ".lock", "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def find_file_with_id(id_):
    # str(id) is always a literal substring of the file bytes (4-hex or numeric id,
    # no JSON escaping), so a cheap byte scan skips files that can't contain it
    # before paying for a full fold. A coincidental substring match just folds one
    # extra file; the id_ in fold() check keeps correctness exact.
    needle = str(id_).encode()
    for path in sorted(DATA_DIR.glob("*.jsonl"), reverse=True):
        try:
            if needle in path.read_bytes() and id_ in fold(path):
                return path
        except FileNotFoundError:
            continue
    return None


_DATED_STEM = re.compile(r"^\d{4}-\d{2}-\d{2}-(.+)$")


def find_project_dup(path, type_, field, key):
    """path's project, every dated file, newest first -> the id of an
    existing type_ event whose field matches key case-insensitively, or None.
    Files roll over daily (one date+project per file), so a term/diagram
    recorded again on a later day must find the id already minted for it in
    an OLDER file instead of never looking past today's, and only reuse that
    id - the caller still writes into today's file (#140)."""
    m = _DATED_STEM.match(path.stem)
    pattern = f"*-{glob.escape(m.group(1))}.jsonl" if m else path.name
    for p in sorted(DATA_DIR.glob(pattern), reverse=True):
        state = fold(p)
        i = next((eid for eid, e in state.items()
                  if e.get("type") == type_ and e.get(field, "").lower() == key.lower()),
                 None)
        if i is not None:
            return i
    return None


def session_code(env=None):
    """Four chars of the agent's own session id, or ''. One log file is one
    date+project and can hold several sessions, so identity belongs on the
    EVENT, not the filename."""
    return ((env if env is not None else os.environ).get("CLAUDE_CODE_SESSION_ID") or "")[:4]


def add_event(project, fields):
    f = session_file(project)
    with mint_lock():
        i = new_id()
        ev = {"id": i, "ts": int(time.time()), **fields}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(f, ev)
    return i


def add_term(path, term, intuitive, technical):
    """Same term (case-insensitive), anywhere in this project's dated files ->
    reuse its id so the merged glossary shows one row, but ALWAYS append to
    `path` (today's file) - never to the older file that minted the id - so
    the session recording it can see its own row on its own card: writing
    into an old file instead would make that file's summarize.latest jump to
    now, and this session's fold would show nothing it just recorded (#140).
    merge_projects keeps the newest-ts copy when an id spans files."""
    with mint_lock():
        existing = find_project_dup(path, "term", "term", term)
        i = existing if existing is not None else new_id()
        ev = {"id": i, "type": "term", "term": term, "intuitive": intuitive,
              "technical": technical, "ts": int(time.time())}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(path, ev)
    return i


def add_diagram(path, title, mermaid):
    """Same title (case-insensitive), anywhere in this project's dated files
    -> reuse its id so the merged view shows one, current diagram, but ALWAYS
    append to `path` (today's file) - never to the older file that minted the
    id - so the session recording it can see its own row on its own card
    (#140). merge_projects keeps the newest-ts copy when an id spans files,
    so the older file's superseded source is what the wall stops showing,
    while that file's own history still honestly says it was recorded there."""
    with mint_lock():
        existing = find_project_dup(path, "diagram", "title", title)
        i = existing if existing is not None else new_id()
        ev = {"id": i, "type": "diagram", "title": title,
              "mermaid": mermaid, "ts": int(time.time())}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(path, ev)
    return i


def with_extras(fields, args):
    """The optional extras action/task/progress share. Only a flag that was
    actually given (and non-empty) lands in the event: fold() shallow-merges
    by id, so a null written here would CLEAR the field on every later
    progress update that did not repeat it."""
    for k in ("intuitive", "diagram"):
        v = getattr(args, k, None)
        if v:
            fields[k] = v
    return fields


def blocker(action_id, state_of):
    """Validate that `action_id` is a real, still-open action, and return it.

    A task that cannot advance without the user is not running, and saying so
    in free-text progress hides the ask where nothing can find it: not
    `show --open`, not the wall's actions section, and not an id the user can
    answer. Requiring a real open action to point at is what makes "blocked
    with no blocker" impossible to express rather than merely discouraged.

    state_of(id) -> the folded event, so the check is testable without a disk.
    """
    ev = state_of(action_id)
    if not ev:
        sys.exit(f"error: --blocked-on '{action_id}' not found; a blocked task "
                 "must point at a real action")
    if ev.get("type") != "action":
        sys.exit(f"error: --blocked-on '{action_id}' is a {ev.get('type')}, not an "
                 "action; only a decision you are waiting on can block a task")
    if ev.get("status") == "done":
        sys.exit(f"error: --blocked-on '{action_id}' is already done, so it "
                 "cannot be what you are waiting for")
    return action_id


def stale_hundreds(states, skip_id=None):
    """Ids of tasks that say they are finished but were never closed.

    `done` is run by the session and by nothing else, so a task at 100% that is
    still open is the one shape of protocol drift the data can see by itself.
    Three exclusions keep it honest rather than noisy:

    - the literal `pct` field only, never tt_model's scrape, which reads any
      percentage in the prose and once turned "92% of 5039 genes above zero"
      into a 92% bar on work that had barely started;
    - never the id this invocation just wrote, or `progress --pct 100` would
      warn about itself every time and the warning would train its own reader
      to skip it;
    - never a task blocked on a still-open action, which is a legitimately
      open task at 100% waiting on the user.
    """
    blocking = {i for i, e in states.items()
                if e.get("type") == "action" and e.get("status") != "done"}
    return sorted(
        i for i, e in states.items()
        if i != skip_id
        and e.get("type") == "task" and e.get("status") != "done"
        and isinstance(e.get("pct"), int) and e.get("pct") == 100
        and e.get("blocked_on") not in blocking)


def warn_stale(project, skip_id=None):
    """Nudge about tasks left open at 100%, on stderr, never fatally.

    Runs after every recording command because those are what a session
    actually runs; a check that only fires inside `show --open` would depend on
    the same sweep that already failed. Costs one fold of the project's files -
    1.0 ms across five of them - and swallows everything, because a warning
    that could break `table-talk done` would be worse than no warning at all.
    """
    try:
        states = {}
        for path in sorted(DATA_DIR.glob(f"*-{glob.escape(project)}.jsonl")):
            states.update(fold(path))
        ids = stale_hundreds(states, skip_id)
    except Exception:               # a nudge must never break a recording
        return
    if ids:
        print(f"note: {', '.join(ids)} at 100% and still open — `table-talk "
              f"done <id>`, or `progress <id> --blocked-on <action-id>` if it "
              f"is waiting on the user", file=sys.stderr)


def _lookup(id_):
    """The folded event for an id, anywhere in the data dir, or {}."""
    f = find_file_with_id(id_)
    return fold(f).get(id_, {}) if f else {}


def progress_fields(args):
    """The event one `progress` call appends.

    A reading gets its OWN clock. ts moves on every append - it has to, it
    drives recency and the change gutters - but the card prints the reading's
    time, and an --intuitive or --diagram amend takes no reading. Without
    read_ts, annotating a job re-dated its bar to now while the number under it
    stayed hours old: the exact lie the clock was added to prevent.
    """
    fields = with_extras({"progress": args.text} if args.text else {}, args)
    if args.pct is not None:            # 0 is a reading; with_extras drops falsy
        fields["pct"] = args.pct
    if getattr(args, "blocked_on", None):
        fields["blocked_on"] = blocker(args.blocked_on, _lookup)
    if "progress" in fields or "pct" in fields:
        fields["read_ts"] = int(time.time())
    return fields


def transfer(ev, me):
    """Who an item belongs to after this write, and what to say about it.

    Returns (extra fields, notice-or-None). Ownership is one field on one event,
    so a hand-off is one more key on the append update() already performs: no
    second file, no new status, nothing whose ordering matters, and nothing for
    a crash to land between. The item does not change file - `show --mine`
    globs every dated file of the project and filters on sid, so the new owner
    sees it wherever it lives.

    An item with no sid is adopted silently: there is no session to take it
    from. A caller with no sid takes nothing: that is a human terminal.
    """
    owner = ev.get("sid")
    if not (owner and me and owner != me):
        return {}, None
    return {"sid": me}, f"moved {ev.get('id')} from session {owner} to {me}"


def update(id_, fields):
    """Append a partial update to the file that contains id_ (folding is per-file)."""
    f = find_file_with_id(id_)
    if not f:
        sys.exit(f"error: id '{id_}' not found in {DATA_DIR}")
    ev = fold(f).get(id_, {})
    typ = ev.get("type")
    if typ not in ("action", "task"):
        sys.exit(f"error: id '{id_}' is a {typ or 'unknown record'}, not an action/task")
    extra, notice = transfer(ev, session_code())
    if notice:
        # stderr, and the skill also requires the reply to say it: the premise
        # is that the session did not know whose item this was.
        print(notice, file=sys.stderr)
    append(f, {"id": id_, "ts": int(time.time()), **fields, **extra})


SETTINGS_PATH = Path.home() / ".claude" / "settings.json"


def hook_entry(command):
    """The PostToolUse entry that runs `command` on every tool call."""
    return {"matcher": "", "hooks": [{"type": "command", "command": command,
                                      "timeout": 5}]}


def edit_hooks(settings, command, remove=False):
    """settings dict -> (new dict, what changed).

    MERGE, never overwrite: this file holds the user's permissions, model
    choice and plugins, and clobbering it would be far worse than the feature
    is worth. Idempotent, so re-running the installer cannot accumulate
    duplicates - identity is the command string, which is this checkout's own
    absolute path, so two clones do not fight over one entry.
    """
    out = json.loads(json.dumps(settings))          # never mutate the caller's
    events = out.setdefault("hooks", {})
    entries = events.setdefault("PostToolUse", [])
    has = [e for e in entries if any(h.get("command") == command
                                     for h in (e.get("hooks") or []))]
    if remove:
        if not has:
            return settings, "not installed"
        events["PostToolUse"] = [e for e in entries if e not in has]
        if not events["PostToolUse"]:
            events.pop("PostToolUse")
        if not events:
            out.pop("hooks")
        return out, "removed"
    if has:
        return settings, "already installed"
    entries.append(hook_entry(command))
    return out, "installed"


def cmd_install_hook(remove=False, path=None):
    """Add (or remove) the heartbeat hook in the user's Claude Code settings.

    Backed up before the first change and written atomically, because an
    interrupted write to this file would break every Claude Code session, not
    just this tool.
    """
    p = Path(path) if path else SETTINGS_PATH
    beat = str(Path(__file__).resolve().parent / "tt-beat")
    try:
        current = json.loads(p.read_text()) if p.exists() else {}
    except (OSError, ValueError) as e:
        sys.exit(f"error: cannot read {p}: {e}\nfix or move it, then re-run - "
                 "this file is not something to overwrite blindly")
    if not isinstance(current, dict):
        sys.exit(f"error: {p} is not a JSON object; refusing to touch it")
    new, what = edit_hooks(current, beat, remove)
    if new is current:
        print(f"heartbeat hook: {what}")
        return
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        if p.exists():
            backup = p.with_suffix(".json.table-talk.bak")
            if not backup.exists():
                backup.write_text(p.read_text())
                print(f"backed up your settings to {backup}")
        tmp = p.with_suffix(".json.tt-tmp")
        tmp.write_text(json.dumps(new, indent=2) + "\n")
        os.replace(tmp, p)          # atomic: a half-written settings.json
    except OSError as e:            # would break every Claude Code session
        sys.exit(f"error: cannot write {p}: {e}")
    print(f"heartbeat hook: {what} ({beat})")
    if what == "installed" and not shutil.which("jq"):
        print("warning: jq is not installed, so the hook will do nothing "
              "silently - install jq to get heartbeats", file=sys.stderr)
    if what == "installed":
        print("it runs on every tool call in every project, exits 0 whatever "
              "happens, and costs about 8 ms.\nremove it with: table-talk "
              "install-hook --remove")


def cmd_show(project, open_only=False, mine=False):
    """Dump folded state, one JSON object per line under a `== stem` header.

    --open narrows to obligations still outstanding, which is what a session
    needs to write its own reply tables; a term or a diagram is reference, never
    an obligation, so neither survives it. --mine narrows to rows THIS session
    recorded: one log file is one date+project and several sessions share it, so
    an unfiltered dump makes a session claim asks it never made and cannot
    answer. A file with nothing to show prints no header.
    """
    me = session_code()
    if mine and not me:
        sys.exit("error: --mine needs CLAUDE_CODE_SESSION_ID, which only an "
                 "agent session has; drop it to see every session's rows")
    pattern = f"*-{glob.escape(project)}.jsonl" if project else "*.jsonl"
    for path in sorted(DATA_DIR.glob(pattern)):
        rows = list(fold(path).values())
        if open_only:
            rows = [e for e in rows
                    if e.get("type") in ("action", "task") and e.get("status") != "done"]
        if mine:
            rows = [e for e in rows if e.get("sid") == me]
        if not rows:
            continue
        print(f"== {path.stem}")
        for e in rows:
            print(json.dumps(e))


DEFAULT_PORT = 8731


def dashboard_url():
    """Where the dashboard is, according to the same config the dashboard reads.

    Imported lazily and tolerantly on purpose: tt_config needs tomllib, which is
    3.11+, while this CLI is stdlib-only down to 3.10 - RECORDING must never
    depend on being able to read the dashboard's config. Without this, a
    configured server.port left every liveness check and every 'see the
    dashboard' pointer aimed at 8731, so a session reported the dashboard down
    while it was running and sent the user to a dead link.
    """
    try:
        import tt_config
        port = tt_config.load()["server"]["port"]
    except ImportError:
        port = DEFAULT_PORT
    return f"http://127.0.0.1:{port}/"


def serve_refusal(env, force, url=None):
    """Why serve must not start here, or None.

    serve never returns - it BECOMES the dashboard - so a Claude session that
    runs it wedges until its tool timeout. And the obvious liveness check lies:
    pgrep -f "table-talk serve" matches nothing once execv renames the process,
    so a session that checked first still concludes 'not running'. CLAUDECODE
    exactly, never CLAUDE_CODE_*: the user's own VS Code terminal carries
    CLAUDE_CODE_SSE_PORT, and a broad match would lock the human out too.
    """
    if env.get("CLAUDECODE") and not force:
        return ("error: table-talk serve never exits, and this is a Claude Code "
                "session - it would hang until the tool timeout.\n"
                "check instead:  curl -sf -o /dev/null --max-time 2 "
                f"{url or dashboard_url()} && echo up || echo down\n"
                "If it is down, ask the user to run `table-talk serve` in their "
                "own terminal (or pass --force to insist).")
    return None


def cmd_serve(port, force=False):
    if (msg := serve_refusal(os.environ, force)):
        sys.exit(msg)
    dash = Path(__file__).resolve().parent / "table-talk-dash.py"
    uv = shutil.which("uv")
    if not uv:
        sys.exit("error: uv not found on PATH - install from https://docs.astral.sh/uv/")
    # --port is passed ONLY when it was given: unset, the dashboard reads
    # server.port out of the config, and forwarding a default here would beat it.
    argv = [uv, "run", "--script", str(dash)] + (["--port", str(port)] if port is not None else [])
    os.execv(uv, argv)


def selftest():
    import tempfile, io, contextlib
    global DATA_DIR
    with tempfile.TemporaryDirectory() as td:
        DATA_DIR = Path(td)
        f = session_file("proj")
        append(f, {"id": "a1b2", "type": "action", "status": "open",
                   "background": "bg", "why": "w", "rec": "r", "ts": 1})
        append(f, {"id": "a1b2", "status": "done", "ts": 2})
        s = fold(f)
        assert s["a1b2"]["status"] == "done", "update must apply"
        assert s["a1b2"]["why"] == "w", "partial update must preserve other fields"
        with open(f, "a") as fh:
            fh.write("not json\n")
        assert fold(f)["a1b2"]["background"] == "bg", "malformed line must not break fold"
        with open(f, "ab") as fh:
            fh.write(b"\xff\xfe bad utf8\n")
        assert fold(f)["a1b2"]["background"] == "bg", "invalid utf-8 line must not break fold"
        assert fold(Path(td) / "does-not-exist.jsonl") == {}, "missing file folds to empty"
        with open(f, "a") as fh:
            fh.write('{"id": 77, "type": "task", "what": "int id"}\n')
        assert "77" in fold(f), "non-string id is reachable as str"
        i1 = add_term(f, "FVA", "v1", "t1")
        i2 = add_term(f, "fva", "v2", "t2")
        assert i1 == i2, "term dedupe is case-insensitive"
        assert fold(f)[i1]["intuitive"] == "v2", "term re-add updates definitions"
        # argv hands us lone surrogates for bytes it could not decode; written
        # through, they stop the dashboard rendering at all (orjson refuses the
        # payload, and NiceGUI requires orjson).
        assert scrub("bad \udcff") == "bad \\udcff" and scrub(42) == 42, \
            "the escape names the byte that would not decode; '?' would not"
        i_bad = add_event("proj", {"type": "task", "status": "open", "what": "log \udcfe"})
        got = fold(f)[i_bad]["what"]
        assert got == "log \\udcfe", "a surrogate is escaped at the write boundary"
        got.encode("utf-8")   # raises UnicodeEncodeError if one ever survives
        # cmd_show's filters: one log file is one date+project and SEVERAL
        # sessions share it, so an unfiltered dump makes a session claim asks it
        # never made. Captured rather than eyeballed - the skill runs this.
        os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"
        try:
            mine_open = add_event("shw", {"type": "action", "status": "open",
                                          "background": "mine", "why": "w", "rec": "r"})
            mine_done = add_event("shw", {"type": "action", "status": "open",
                                          "background": "closed", "why": "w", "rec": "r"})
            update(mine_done, {"status": "done"})
            add_term(session_file("shw"), "T", "i", "t")
            os.environ["CLAUDE_CODE_SESSION_ID"] = "bbbb-y"
            theirs = add_event("shw", {"type": "action", "status": "open",
                                       "background": "theirs", "why": "w", "rec": "r"})
        finally:
            os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"

        def _show(**kw):
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                cmd_show("shw", **kw)
            return [json.loads(ln) for ln in buf.getvalue().splitlines()
                    if ln.startswith("{")]

        ids = {e["id"] for e in _show(open_only=True)}
        assert mine_open in ids and theirs in ids, "--open spans every session"
        assert mine_done not in ids, "--open drops what is already done"
        assert not any(e["type"] == "term" for e in _show(open_only=True)), \
            "a term is reference, never an obligation, so --open must not list it"
        mine_ids = {e["id"] for e in _show(open_only=True, mine=True)}
        assert mine_ids == {mine_open}, \
            "--mine is what stops a session claiming another session's asks"
        del os.environ["CLAUDE_CODE_SESSION_ID"]
        try:
            _show(mine=True)
            raise AssertionError("--mine without a session id must refuse, not show everything")
        except SystemExit:
            pass
        os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"

        # Ownership is one field on one event, so a hand-off is one more key on the
        # append update() already makes. A session that forgot whose item it was
        # touching is exactly the case this must catch.
        assert transfer({"id": "4c1a", "sid": "7e2b"}, "9f3c") == (
            {"sid": "9f3c"}, "moved 4c1a from session 7e2b to 9f3c")
        assert transfer({"id": "4c1a", "sid": "7e2b"}, "7e2b") == ({}, None), \
            "the owner touching its own item is not a transfer"
        assert transfer({"id": "4c1a"}, "9f3c") == ({}, None), \
            "an item with no session is adopted silently: there is nobody to take it from"
        assert transfer({"id": "4c1a", "sid": "7e2b"}, "") == ({}, None), \
            "a human terminal has no session id and must not take anything over"

        os.environ["CLAUDE_CODE_SESSION_ID"] = "7e2bxxxx"
        owned = add_event("shift", {"type": "action", "status": "open",
                                    "background": "b", "why": "w", "rec": "r"})
        os.environ["CLAUDE_CODE_SESSION_ID"] = "9f3cxxxx"
        update(owned, {"progress": "taken over"})
        assert fold(session_file("shift"))[owned]["sid"] == "9f3c", \
            "touching another session's item hands it over; nothing else does"
        assert fold(session_file("shift"))[owned]["background"] == "b", \
            "and the hand-off must not disturb any other field"
        os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"

        assert find_file_with_id("a1b2") == f
        assert find_file_with_id("ffff") is None
        i3 = add_event("proj", {"type": "task", "status": "open", "what": "x"})
        update(i3, {"progress": "50%"})
        assert fold(f)[i3]["progress"] == "50%" and fold(f)[i3]["what"] == "x"
        assert len(i3) == 4
        assert session_code({}) == "", "no session id, no stamp"
        assert session_code({"CLAUDE_CODE_SESSION_ID": "9f3c8a1e-dead"}) == "9f3c", \
            "four chars is enough to tell sessions apart and fits the id column"
        prev = os.environ.get("CLAUDE_CODE_SESSION_ID")
        os.environ["CLAUDE_CODE_SESSION_ID"] = "abcd1234-x"
        try:
            i5 = add_event("proj", {"type": "task", "status": "open", "what": "s"})
            assert fold(session_file("proj"))[i5]["sid"] == "abcd"
        finally:
            if prev is None:
                os.environ.pop("CLAUDE_CODE_SESSION_ID", None)
            else:
                os.environ["CLAUDE_CODE_SESSION_ID"] = prev
        # new_id must avoid ids used in ANY file, not just one
        other = session_file("other")
        append(other, {"id": "d00d", "type": "task", "what": "y", "ts": 1})
        orig = secrets.token_hex
        free = next(x for x in ("beef", "b33f", "f00d", "c0de") if x not in all_ids())
        draws = iter(["d00d", free])
        secrets.token_hex = lambda n=2: next(draws)
        try:
            assert new_id() == free, "new_id must skip an id used in any file"
        finally:
            secrets.token_hex = orig
        assert safe_project("a/b") == "a_b" and safe_project("x") == "x", "project separators sanitized"
        assert session_file("sub/dir").name.endswith("-sub_dir.jsonl"), "slash project does not crash"
        tid = add_term(f, "GUARD", "i", "t")
        try:
            update(tid, {"status": "done"})
            raise AssertionError("update on a term must be rejected")
        except SystemExit:
            pass
        assert "status" not in fold(f)[tid], "a rejected update must not touch the term"
        d1 = add_diagram(f, "Pipeline", "flowchart TD\n  a --> b")
        d2 = add_diagram(f, "pipeline", "flowchart TD\n  a --> c")
        assert d1 == d2, "diagram dedupe is case-insensitive on the title"
        assert fold(f)[d1]["mermaid"].endswith("a --> c"), \
            "re-recording a title REPLACES the source: a diagram is iterated on"
        try:
            update(d1, {"status": "done"})
            raise AssertionError("done on a diagram must be rejected")
        except SystemExit:
            pass
        # #140: files roll over daily, so recording the SAME term/diagram
        # again on a LATER day must find the id already minted for it in an
        # OLDER file of the same project, but the new event still belongs to
        # TODAY's file - the session recording it must see its own row on its
        # own card, and the older file must keep its history undisturbed.
        old_term_file = Path(td) / "2020-01-01-dated.jsonl"
        old_term_file.touch()
        append(old_term_file, {"id": "fva1", "type": "term", "term": "FVA",
                               "intuitive": "old", "technical": "old t", "ts": 1})
        today_dated = session_file("dated")
        reused_term = add_term(today_dated, "fva", "new", "new t")
        assert reused_term == "fva1", \
            "recording the same term on a later day must reuse its id, so the merged glossary shows one row, not a duplicate (#140)"
        assert fold(today_dated)["fva1"]["intuitive"] == "new", \
            "the new event must land in TODAY's file, so the session that just recorded it sees it on its own card, not only in an old file it never touched (#140)"
        assert fold(old_term_file)["fva1"]["intuitive"] == "old", \
            "the OLDER file must be left untouched - it honestly recorded that definition then, and writing into it would falsify its recency (#140)"

        old_diagram_file = Path(td) / "2020-01-01-dgram.jsonl"
        old_diagram_file.touch()
        append(old_diagram_file, {"id": "dg01", "type": "diagram", "title": "Flow",
                                  "mermaid": "flowchart LR\n  a --> b", "ts": 1})
        today_dgram = session_file("dgram")
        reused_diagram = add_diagram(today_dgram, "flow", "flowchart LR\n  a --> z")
        assert reused_diagram == "dg01", \
            "recording the same diagram title on a later day must reuse its id, not mint a duplicate (#140)"
        assert fold(today_dgram)["dg01"]["mermaid"].endswith("a --> z"), \
            "the replacement source must land in TODAY's file, so the recording session sees its own diagram on its own card (#140)"
        assert fold(old_diagram_file)["dg01"]["mermaid"].endswith("a --> b"), \
            "the OLDER file's own history must not be rewritten (#140)"
    from types import SimpleNamespace as NS
    # blocker: a blocked task must point at a real, OPEN action. This is what
    # makes "blocked with no blocker" impossible to express - the failure it
    # replaces was an ask hidden in free-text progress, which nothing could
    # find and the user could not answer by id.
    _fake = {"a100": {"type": "action", "status": "open"},
             "a200": {"type": "action", "status": "done"},
             "t300": {"type": "task", "status": "open"}}
    assert blocker("a100", _fake.get) == "a100"
    for bad, why in (("a200", "an action already answered cannot be what you wait for"),
                     ("t300", "a task cannot block a task; only a decision can"),
                     ("zzzz", "an id that does not exist is not a blocker")):
        try:
            blocker(bad, _fake.get)
            raise AssertionError(f"blocker({bad!r}) must refuse: {why}")
        except SystemExit:
            pass

    # stale_hundreds: a task that says it is finished but was never closed.
    open_act = {"type": "action", "status": "open"}
    st = {"aaaa": {"id": "aaaa", "type": "task", "status": "open", "pct": 100},
          "bbbb": {"id": "bbbb", "type": "task", "status": "open", "pct": 60},
          "cccc": {"id": "cccc", "type": "task", "status": "done", "pct": 100},
          "dddd": {"id": "dddd", "type": "action", "status": "open", "pct": 100},
          "eeee": open_act}
    assert stale_hundreds(st) == ["aaaa"], \
        "only an OPEN TASK at an explicit 100 is stale: a finished one is " \
        "closed, a partial one is running, and an action has no percentage"
    assert stale_hundreds(st, skip_id="aaaa") == [], \
        "`progress <id> --pct 100` must not warn about the very id it just " \
        "wrote - it would fire on every single completion, and a warning " \
        "that always fires is one nobody reads"
    st["aaaa"]["blocked_on"] = "eeee"
    assert stale_hundreds(st) == [], \
        "a task blocked on a still-open action is legitimately open at 100%: " \
        "this is exactly f389 awaiting a merge decision, and warning about it " \
        "would teach the session to ignore the warning"
    st["eeee"] = {"type": "action", "status": "done"}
    assert stale_hundreds(st) == ["aaaa"], \
        "once the blocking action is answered the task is stale again - a " \
        "stale blocker must not hide it forever"
    st["aaaa"]["pct"] = "100"
    assert stale_hundreds(st) == [], \
        "pct is compared as a number, so a string cannot count as complete"
    st["aaaa"]["pct"] = 100.0
    assert stale_hundreds(st) == [], \
        "pct must be a literal int - a float that equals 100 must not count " \
        "as complete either, or a stray float reading would trip the warning"
    st["aaaa"]["pct"] = 100
    st["ffff"] = {"id": "ffff", "type": "task", "status": "open", "pct": 100}
    assert stale_hundreds(st) == ["aaaa", "ffff"], "ids come back sorted"
    # inserted BEFORE "aaaa" alphabetically but AFTER it in dict insertion
    # order, so this is the entry that actually distinguishes sorted() from
    # insertion order - without it, this dict's own key order happens to
    # already read alphabetically and the pin above would pass by luck.
    st["0001"] = {"id": "0001", "type": "task", "status": "open", "pct": 100}
    assert stale_hundreds(st) == ["0001", "aaaa", "ffff"], \
        "the wall must not reorder itself between reads: unsorted ids would " \
        "make every render of the same state look like a different list"
    assert stale_hundreds({"gggg": {"type": "task", "status": "open",
                                    "progress": "92% of 5039 genes above zero"}}) == [], \
        "staleness reads the literal pct field and NEVER scrapes prose: the " \
        "scrape already turned that exact sentence - a RESULT - into a 92% bar"

    # warn_stale: the nudge itself, on the real file layout.
    with tempfile.TemporaryDirectory() as td:
        keep, DATA_DIR = DATA_DIR, Path(td)
        try:
            f = DATA_DIR / "2026-01-01-proj.jsonl"
            f.write_text(json.dumps({"id": "aaaa", "type": "task",
                                     "status": "open", "pct": 100}) + "\n")
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("proj")
            assert "aaaa" in err.getvalue(), \
                "the warning must NAME the stale id: a nudge the reader has " \
                "to go hunting for is one they will not act on"
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("proj", skip_id="aaaa")
            assert err.getvalue() == "", "the id just written is never named"
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("nonesuch")
            assert err.getvalue() == "", \
                "a project with nothing stale must print NOTHING - a warning " \
                "that appears on every clean run is noise, not a signal"
            (DATA_DIR / "unreadable.jsonl").write_text("{ not json\n")
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("proj")
            assert "aaaa" in err.getvalue(), \
                "one corrupt file must not silence the check for the rest: " \
                "recording is what must never break, and this is only a nudge"
        finally:
            DATA_DIR = keep

    # progress_fields: the reading's clock must not move when no reading was
    # taken. This is the whole reason the field exists.
    assert "read_ts" in progress_fields(NS(text="epoch 3/10", pct=None, intuitive=None, diagram=None))
    assert "read_ts" in progress_fields(NS(text=None, pct=0, intuitive=None, diagram=None)), \
        "0% is a reading like any other"
    amend = progress_fields(NS(text=None, pct=None, intuitive="plain words", diagram=None))
    assert amend == {"intuitive": "plain words"}, \
        "an amend takes no reading, so it must not re-date the bar: the card " \
        "would claim a fresh clock over an hours-old number"
    assert progress_fields(NS(text=None, pct=None, intuitive=None, diagram="x")) == {"diagram": "x"}

    assert with_extras({"a": 1}, NS(diagram="x", intuitive=None)) == {"a": 1, "diagram": "x"}
    assert with_extras({}, NS()) == {}, "absent flags write nothing"
    assert with_extras({}, NS(diagram="", intuitive="i")) == {"intuitive": "i"}, \
        "an empty string is not an extra - it must not land in the event"
    i4 = add_event("proj", {"type": "action", "status": "open", "background": "b",
                            "why": "w", "rec": "r"})
    update(i4, with_extras({}, NS(intuitive="plain words", diagram=None)))
    got = fold(session_file("proj"))[i4]
    assert got["intuitive"] == "plain words" and got["background"] == "b", \
        "an amend adds the field and touches nothing else"
    assert "progress" not in got, \
        "amending an ACTION must not invent a progress note it never had"
    # serve_refusal: pure, so both directions are testable without exec'ing uv
    assert serve_refusal({}, False) is None, "a human terminal is never refused"
    assert serve_refusal({"CLAUDE_CODE_SSE_PORT": "1"}, False) is None, \
        "the user's own VS Code terminal carries CLAUDE_CODE_* vars; only " \
        "CLAUDECODE itself marks a Claude session"
    # This file MINUS this function: the needle would otherwise match its own
    # assertion. Both halves matter - main() is defined AFTER selftest, and the
    # help string lives there, so splitting only on "def selftest" would leave
    # the very line this pin exists for outside the search.
    src = Path(__file__).read_text()
    code = src.split("def selftest():")[0] + src.split("\ndef main(", 1)[1]
    assert "flowchart LR" not in code, \
        "the CLI help must not offer the orientation the skill forbids"
    assert "warn_stale(getattr(args, \"project\", None)" in code, \
        "the nudge must fire from main() after a recording command: defined " \
        "and never called, it catches exactly nothing"
    assert dashboard_url().startswith("http://127.0.0.1:") and dashboard_url().endswith("/")
    assert "9500" in serve_refusal({"CLAUDECODE": "1"}, False, url="http://127.0.0.1:9500/"), \
        "the refusal names the port the dashboard is ACTUALLY on: hardcoded, it " \
        "told every session to curl 8731 and report a running dashboard as down"
    msg = serve_refusal({"CLAUDECODE": "1"}, False)
    assert msg and "curl" in msg and "--force" in msg, \
        "the refusal must hand back the liveness check that actually works " \
        "(pgrep -f 'table-talk serve' never matches: execv renames the process)"
    assert serve_refusal({"CLAUDECODE": "1"}, True) is None, "--force overrides"
    # edit_hooks: this touches the user's ~/.claude/settings.json, which holds
    # their permissions, model choice and plugins. Every pin here is about not
    # destroying that file.
    keep = {"model": "opus", "permissions": {"allow": ["Bash"]},
            "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": []}]}}
    got, what = edit_hooks(keep, "/x/tt-beat")
    assert what == "installed" and got["model"] == "opus" \
        and got["permissions"] == {"allow": ["Bash"]} \
        and got["hooks"]["PreToolUse"] == keep["hooks"]["PreToolUse"], \
        "installing the hook must MERGE: a settings.json that lost the user's " \
        "permissions or their other hooks is a far worse bug than no heartbeat"
    assert keep["hooks"].get("PostToolUse") is None, \
        "edit_hooks must not mutate the dict it was handed - the caller " \
        "compares old to new to decide whether to write at all"
    assert got["hooks"]["PostToolUse"][0]["hooks"][0]["command"] == "/x/tt-beat" \
        and got["hooks"]["PostToolUse"][0]["hooks"][0]["type"] == "command" \
        and got["hooks"]["PostToolUse"][0]["matcher"] == "", \
        "the entry must match Claude Code's hook schema, or it is ignored " \
        "silently and the wall never shows a heartbeat"
    again, what = edit_hooks(got, "/x/tt-beat")
    assert what == "already installed" and again is got, \
        "re-running the installer must not stack duplicate hooks - every tool " \
        "call would then pay for the beat twice"
    other, what = edit_hooks(got, "/other/checkout/tt-beat")
    assert what == "installed" and len(other["hooks"]["PostToolUse"]) == 2, \
        "identity is the command path, so a second checkout installs its own"
    gone, what = edit_hooks(got, "/x/tt-beat", remove=True)
    assert what == "removed" and "PostToolUse" not in gone.get("hooks", {}) \
        and gone["model"] == "opus", \
        "--remove must take out only our entry and leave the rest of the file"
    assert "hooks" in gone and "PreToolUse" in gone["hooks"], \
        "removing our hook must not drop the user's OTHER hooks with it"
    empty, what = edit_hooks({}, "/x/tt-beat", remove=True)
    assert what == "not installed" and empty == {}, \
        "removing what was never installed must leave the file untouched"
    tidy, _ = edit_hooks(edit_hooks({}, "/x/tt-beat")[0], "/x/tt-beat", remove=True)
    assert tidy == {}, "removal leaves no empty scaffolding behind"
    # The write path itself, on a real file: a backup exists before the first
    # change, and a second run neither duplicates nor re-backs-up.
    with tempfile.TemporaryDirectory() as d:
        sp = Path(d) / "settings.json"
        sp.write_text(json.dumps({"model": "opus"}))
        cmd_install_hook(path=sp)
        first = json.loads(sp.read_text())
        backup = sp.with_suffix(".json.table-talk.bak")
        assert json.loads(backup.read_text()) == {"model": "opus"}, \
            "the pre-existing settings must be recoverable: this is the file " \
            "every Claude Code session reads, and we edit it during an install"
        cmd_install_hook(path=sp)
        assert json.loads(sp.read_text()) == first, "the second run is a no-op"
        assert not list(Path(d).glob("*tt-tmp")), \
            "the atomic temp file must not survive: a half-written " \
            "settings.json breaks every Claude Code session, not just this tool"
        # --remove is a REAL write, so it is what proves the backup is taken
        # once and never again; a no-op re-run would not exercise this at all.
        backup.write_text('{"marker": 1}')
        cmd_install_hook(remove=True, path=sp)
        assert json.loads(sp.read_text()) == {"model": "opus"}, \
            "--remove must return the file to what it was"
        assert json.loads(backup.read_text()) == {"marker": 1}, \
            "a later run must not overwrite the backup with hooked settings - " \
            "that would destroy the only copy of the user's original"
    assert 'jq -r' in (Path(__file__).resolve().parent / "tt-beat").read_text() \
        and 'shutil.which("jq")' in code, \
        "tt-beat parses its payload with jq, so installing the hook on a box " \
        "without jq must warn: otherwise it no-ops silently and the wall just " \
        "never shows a heartbeat, with nothing anywhere saying why"
    # The user's actual question: the hook must be part of `./install.sh`, not a
    # README paragraph they have to notice.
    setup = (Path(__file__).resolve().parent.parent / "install.sh").read_text()
    assert '"$here/bin/table-talk" install-hook' in setup, \
        "install.sh must set the heartbeat hook up; left as a manual step, the " \
        "one feature that shows whether an agent is working is off for everyone"
    print("ok")


def main():
    p = argparse.ArgumentParser(prog="table-talk", description=__doc__)
    p.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("action", help="record a decision needed from the user")
    a.add_argument("background")
    a.add_argument("--why", required=True)
    a.add_argument("--rec", required=True)
    a.add_argument("--project")
    a.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    a.add_argument("--intuitive", help="plain-English line: what this is and what is needed")

    t = sub.add_parser("task", help="record background work")
    t.add_argument("what")
    t.add_argument("--project")
    t.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    t.add_argument("--intuitive", help="plain-English line: what this job is doing")

    pr = sub.add_parser("progress", help="update progress on an item")
    pr.add_argument("id")
    pr.add_argument("text", nargs="?", help="progress note; omit to only amend --intuitive/--diagram")
    pr.add_argument("--diagram", help="add or replace the item's ASCII sketch")
    pr.add_argument("--intuitive", help="add or replace the item's plain-English line")
    pr.add_argument("--blocked-on", metavar="ACTION_ID",
                    help="this task cannot advance until that action is answered")
    pr.add_argument("--pct", type=int,
                    help="explicit completion 0-100; beats any number found in the text")

    d = sub.add_parser("done", help="mark an item done")
    d.add_argument("id")

    tm = sub.add_parser("term", help="record a technical term")
    tm.add_argument("term")
    tm.add_argument("--intuitive", required=True)
    tm.add_argument("--technical", required=True)
    tm.add_argument("--project")

    dg = sub.add_parser("diagram", help="record a mermaid diagram (the dashboard renders it)")
    dg.add_argument("mermaid", help="mermaid source, e.g. $'flowchart TD\\n  a --> b'")
    dg.add_argument("--title", required=True)
    dg.add_argument("--project")

    sh = sub.add_parser("show", help="dump folded state")
    sh.add_argument("project", nargs="?")
    sh.add_argument("--open", action="store_true",
                    help="only actions and jobs still outstanding")
    sh.add_argument("--mine", action="store_true",
                    help="only rows this session recorded (needs CLAUDE_CODE_SESSION_ID)")

    sub.add_parser("url", help="print the dashboard's URL, per the config")

    ih = sub.add_parser("install-hook",
                        help="add the heartbeat hook to ~/.claude/settings.json")
    ih.add_argument("--remove", action="store_true", help="take it out again")

    sv = sub.add_parser("serve", help="launch the dashboard")
    sv.add_argument("--port", type=int, help="default: server.port from the config (8731)")
    sv.add_argument("--force", action="store_true",
                    help="start even inside a Claude Code session")

    args = p.parse_args()
    if args.selftest:
        selftest()
    elif args.cmd == "action":
        print(add_event(args.project, with_extras(
            {"type": "action", "status": "open", "background": args.background,
             "why": args.why, "rec": args.rec}, args)))
    elif args.cmd == "task":
        print(add_event(args.project, with_extras(
            {"type": "task", "status": "open", "what": args.what}, args)))
    elif args.cmd == "progress":
        update(args.id, progress_fields(args))
    elif args.cmd == "done":
        update(args.id, {"status": "done"})
    elif args.cmd == "term":
        print(add_term(session_file(args.project), args.term, args.intuitive, args.technical))
    elif args.cmd == "diagram":
        print(add_diagram(session_file(args.project), args.title, args.mermaid))
    elif args.cmd == "show":
        cmd_show(args.project, args.open, args.mine)
    elif args.cmd == "install-hook":
        cmd_install_hook(args.remove)
    elif args.cmd == "url":
        print(dashboard_url())
    elif args.cmd == "serve":
        cmd_serve(args.port, args.force)
    else:
        p.print_help()

    if args.cmd in ("action", "task", "progress", "done", "term", "diagram"):
        warn_stale(getattr(args, "project", None) or Path.cwd().name,
                   getattr(args, "id", None))


if __name__ == "__main__":
    main()
