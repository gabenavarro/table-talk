#!/usr/bin/env python3
"""table-talk: record actions, background tasks, technical terms, and mermaid
diagrams for the table-talk reply protocol. Stdlib only — recording must never
need the network. View: `table-talk serve` -> http://127.0.0.1:8731"""
import argparse
import fcntl
import glob
import json
import os
import re
import secrets
import shutil
import sys
import time
from contextlib import contextmanager
from pathlib import Path

DATA_DIR = Path(os.environ.get("TABLE_TALK_DIR") or str(Path.home() / ".local/share/table-talk"))


def fold(path):
    """Current state of one file: shallow-merge events by id, in file order.
    Contract shared with table-talk-dash.py; both selftests pin it."""
    state = {}
    try:
        raw = path.read_bytes()
    except OSError:
        # OSError, not FileNotFoundError: all_ids() folds EVERY file in the data
        # dir on every record, so one unreadable log (chmod, stale mount) or a
        # directory named *.jsonl made `table-talk task ...` die with a raw
        # traceback instead of recording.
        return state
    for n, line in enumerate(raw.splitlines(), 1):
        if not line.strip():
            continue
        try:
            ev = json.loads(line.decode("utf-8"))
            eid = str(ev["id"])
            state[eid] = {**state.get(eid, {}), **ev}
        except (UnicodeDecodeError, json.JSONDecodeError, TypeError, KeyError):
            print(f"warning: skipped malformed line {path.name}:{n}", file=sys.stderr)
    return state


def safe_project(project):
    """A project name becomes a filename component; keep path separators out of it."""
    return re.sub(r"[/\\\x00]", "_", project or Path.cwd().name)


def session_file(project=None):
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        p = DATA_DIR / f"{time.strftime('%Y-%m-%d')}-{safe_project(project)}.jsonl"
        p.touch()
    except OSError as e:
        sys.exit(f"error: cannot write to data dir {DATA_DIR}: {e}")
    return p


def scrub(s):
    """A value that is not valid UTF-8, made writable.

    argv decodes bytes it cannot decode with surrogateescape, so a value piped
    in from another tool - `table-talk progress $id "$(tail -1 train.log)"` -
    can carry lone surrogates. stdlib json writes them without complaint, and
    the dashboard then cannot render AT ALL: NiceGUI hard-requires orjson as
    its socket serialiser and orjson refuses the whole payload, so one stray
    byte in one field stops the page instead of spoiling one cell.

    Escaped at the write boundary, where the damage is one token instead of one
    product. backslashreplace rather than replace: `\\udcfe` still says WHICH
    byte would not decode (0xfe), so the line stays diagnosable, where '?' and
    U+FFFD both throw that away.
    """
    return s.encode("utf-8", "backslashreplace").decode("utf-8") if isinstance(s, str) else s


def append(path, ev):
    with open(path, "a") as f:
        f.write(json.dumps({k: scrub(v) for k, v in ev.items()}) + "\n")


def all_ids():
    """Every id in use across the whole data dir — new ids must avoid all of them."""
    used = set()
    for p in DATA_DIR.glob("*.jsonl"):
        used |= fold(p).keys()
    return used


def new_id():
    used = all_ids()
    while (i := secrets.token_hex(2)) in used:
        pass
    return i


@contextmanager
def mint_lock():
    """Serialize fold+mint+append so concurrent CLIs can't pick or splice the same id."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(DATA_DIR / ".lock", "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def find_file_with_id(id_):
    # str(id) is always a literal substring of the file bytes (4-hex or numeric id,
    # no JSON escaping), so a cheap byte scan skips files that can't contain it
    # before paying for a full fold. A coincidental substring match just folds one
    # extra file; the id_ in fold() check keeps correctness exact.
    needle = str(id_).encode()
    for path in sorted(DATA_DIR.glob("*.jsonl"), reverse=True):
        try:
            if needle in path.read_bytes() and id_ in fold(path):
                return path
        except FileNotFoundError:
            continue
    return None


def session_code(env=None):
    """Four chars of the agent's own session id, or ''. One log file is one
    date+project and can hold several sessions, so identity belongs on the
    EVENT, not the filename."""
    return ((env if env is not None else os.environ).get("CLAUDE_CODE_SESSION_ID") or "")[:4]


def add_event(project, fields):
    f = session_file(project)
    with mint_lock():
        i = new_id()
        ev = {"id": i, "ts": int(time.time()), **fields}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(f, ev)
    return i


def add_term(path, term, intuitive, technical):
    """Same term (case-insensitive) in this file -> reuse id, update definitions."""
    with mint_lock():
        state = fold(path)
        existing = next((i for i, e in state.items() if e.get("type") == "term"
                         and e.get("term", "").lower() == term.lower()), None)
        i = existing or new_id()
        ev = {"id": i, "type": "term", "term": term, "intuitive": intuitive,
              "technical": technical, "ts": int(time.time())}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(path, ev)
    return i


def add_diagram(path, title, mermaid):
    """Same title (case-insensitive) in this file -> reuse id, replace the
    source: a diagram is iterated on, never accumulated."""
    with mint_lock():
        state = fold(path)
        existing = next((i for i, e in state.items() if e.get("type") == "diagram"
                         and e.get("title", "").lower() == title.lower()), None)
        i = existing or new_id()
        ev = {"id": i, "type": "diagram", "title": title,
              "mermaid": mermaid, "ts": int(time.time())}
        if (s := session_code()):
            ev.setdefault("sid", s)
        append(path, ev)
    return i


def with_extras(fields, args):
    """The optional extras action/task/progress share. Only a flag that was
    actually given (and non-empty) lands in the event: fold() shallow-merges
    by id, so a null written here would CLEAR the field on every later
    progress update that did not repeat it."""
    for k in ("intuitive", "diagram"):
        v = getattr(args, k, None)
        if v:
            fields[k] = v
    return fields


def update(id_, fields):
    """Append a partial update to the file that contains id_ (folding is per-file)."""
    f = find_file_with_id(id_)
    if not f:
        sys.exit(f"error: id '{id_}' not found in {DATA_DIR}")
    typ = fold(f).get(id_, {}).get("type")
    if typ not in ("action", "task"):
        sys.exit(f"error: id '{id_}' is a {typ or 'unknown record'}, not an action/task")
    append(f, {"id": id_, "ts": int(time.time()), **fields})


def cmd_show(project, open_only=False, mine=False):
    """Dump folded state, one JSON object per line under a `== stem` header.

    --open narrows to obligations still outstanding, which is what a session
    needs to write its own reply tables; a term or a diagram is reference, never
    an obligation, so neither survives it. --mine narrows to rows THIS session
    recorded: one log file is one date+project and several sessions share it, so
    an unfiltered dump makes a session claim asks it never made and cannot
    answer. A file with nothing to show prints no header.
    """
    me = session_code()
    if mine and not me:
        sys.exit("error: --mine needs CLAUDE_CODE_SESSION_ID, which only an "
                 "agent session has; drop it to see every session's rows")
    pattern = f"*-{glob.escape(project)}.jsonl" if project else "*.jsonl"
    for path in sorted(DATA_DIR.glob(pattern)):
        rows = list(fold(path).values())
        if open_only:
            rows = [e for e in rows
                    if e.get("type") in ("action", "task") and e.get("status") != "done"]
        if mine:
            rows = [e for e in rows if e.get("sid") == me]
        if not rows:
            continue
        print(f"== {path.stem}")
        for e in rows:
            print(json.dumps(e))


def serve_refusal(env, force):
    """Why serve must not start here, or None.

    serve never returns - it BECOMES the dashboard - so a Claude session that
    runs it wedges until its tool timeout. And the obvious liveness check lies:
    pgrep -f "table-talk serve" matches nothing once execv renames the process,
    so a session that checked first still concludes 'not running'. CLAUDECODE
    exactly, never CLAUDE_CODE_*: the user's own VS Code terminal carries
    CLAUDE_CODE_SSE_PORT, and a broad match would lock the human out too.
    """
    if env.get("CLAUDECODE") and not force:
        return ("error: table-talk serve never exits, and this is a Claude Code "
                "session - it would hang until the tool timeout.\n"
                "check instead:  curl -sf -o /dev/null --max-time 2 "
                "http://127.0.0.1:8731/ && echo up || echo down\n"
                "If it is down, ask the user to run `table-talk serve` in their "
                "own terminal (or pass --force to insist).")
    return None


def cmd_serve(port, force=False):
    if (msg := serve_refusal(os.environ, force)):
        sys.exit(msg)
    dash = Path(__file__).resolve().parent / "table-talk-dash.py"
    uv = shutil.which("uv")
    if not uv:
        sys.exit("error: uv not found on PATH - install from https://docs.astral.sh/uv/")
    # --port is passed ONLY when it was given: unset, the dashboard reads
    # server.port out of the config, and forwarding a default here would beat it.
    argv = [uv, "run", "--script", str(dash)] + (["--port", str(port)] if port is not None else [])
    os.execv(uv, argv)


def selftest():
    import tempfile
    global DATA_DIR
    with tempfile.TemporaryDirectory() as td:
        DATA_DIR = Path(td)
        f = session_file("proj")
        append(f, {"id": "a1b2", "type": "action", "status": "open",
                   "background": "bg", "why": "w", "rec": "r", "ts": 1})
        append(f, {"id": "a1b2", "status": "done", "ts": 2})
        s = fold(f)
        assert s["a1b2"]["status"] == "done", "update must apply"
        assert s["a1b2"]["why"] == "w", "partial update must preserve other fields"
        with open(f, "a") as fh:
            fh.write("not json\n")
        assert fold(f)["a1b2"]["background"] == "bg", "malformed line must not break fold"
        with open(f, "ab") as fh:
            fh.write(b"\xff\xfe bad utf8\n")
        assert fold(f)["a1b2"]["background"] == "bg", "invalid utf-8 line must not break fold"
        assert fold(Path(td) / "does-not-exist.jsonl") == {}, "missing file folds to empty"
        with open(f, "a") as fh:
            fh.write('{"id": 77, "type": "task", "what": "int id"}\n')
        assert "77" in fold(f), "non-string id is reachable as str"
        i1 = add_term(f, "FVA", "v1", "t1")
        i2 = add_term(f, "fva", "v2", "t2")
        assert i1 == i2, "term dedupe is case-insensitive"
        assert fold(f)[i1]["intuitive"] == "v2", "term re-add updates definitions"
        # argv hands us lone surrogates for bytes it could not decode; written
        # through, they stop the dashboard rendering at all (orjson refuses the
        # payload, and NiceGUI requires orjson).
        assert scrub("bad \udcff") == "bad \\udcff" and scrub(42) == 42, \
            "the escape names the byte that would not decode; '?' would not"
        i_bad = add_event("proj", {"type": "task", "status": "open", "what": "log \udcfe"})
        got = fold(f)[i_bad]["what"]
        assert got == "log \\udcfe", "a surrogate is escaped at the write boundary"
        got.encode("utf-8")   # raises UnicodeEncodeError if one ever survives
        # cmd_show's filters: one log file is one date+project and SEVERAL
        # sessions share it, so an unfiltered dump makes a session claim asks it
        # never made. Captured rather than eyeballed - the skill runs this.
        import io, contextlib
        os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"
        try:
            mine_open = add_event("shw", {"type": "action", "status": "open",
                                          "background": "mine", "why": "w", "rec": "r"})
            mine_done = add_event("shw", {"type": "action", "status": "open",
                                          "background": "closed", "why": "w", "rec": "r"})
            update(mine_done, {"status": "done"})
            add_term(session_file("shw"), "T", "i", "t")
            os.environ["CLAUDE_CODE_SESSION_ID"] = "bbbb-y"
            theirs = add_event("shw", {"type": "action", "status": "open",
                                       "background": "theirs", "why": "w", "rec": "r"})
        finally:
            os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"

        def _show(**kw):
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                cmd_show("shw", **kw)
            return [json.loads(ln) for ln in buf.getvalue().splitlines()
                    if ln.startswith("{")]

        ids = {e["id"] for e in _show(open_only=True)}
        assert mine_open in ids and theirs in ids, "--open spans every session"
        assert mine_done not in ids, "--open drops what is already done"
        assert not any(e["type"] == "term" for e in _show(open_only=True)), \
            "a term is reference, never an obligation, so --open must not list it"
        mine_ids = {e["id"] for e in _show(open_only=True, mine=True)}
        assert mine_ids == {mine_open}, \
            "--mine is what stops a session claiming another session's asks"
        del os.environ["CLAUDE_CODE_SESSION_ID"]
        try:
            _show(mine=True)
            raise AssertionError("--mine without a session id must refuse, not show everything")
        except SystemExit:
            pass
        os.environ["CLAUDE_CODE_SESSION_ID"] = "aaaa-x"

        assert find_file_with_id("a1b2") == f
        assert find_file_with_id("ffff") is None
        i3 = add_event("proj", {"type": "task", "status": "open", "what": "x"})
        update(i3, {"progress": "50%"})
        assert fold(f)[i3]["progress"] == "50%" and fold(f)[i3]["what"] == "x"
        assert len(i3) == 4
        assert session_code({}) == "", "no session id, no stamp"
        assert session_code({"CLAUDE_CODE_SESSION_ID": "9f3c8a1e-dead"}) == "9f3c", \
            "four chars is enough to tell sessions apart and fits the id column"
        prev = os.environ.get("CLAUDE_CODE_SESSION_ID")
        os.environ["CLAUDE_CODE_SESSION_ID"] = "abcd1234-x"
        try:
            i5 = add_event("proj", {"type": "task", "status": "open", "what": "s"})
            assert fold(session_file("proj"))[i5]["sid"] == "abcd"
        finally:
            if prev is None:
                os.environ.pop("CLAUDE_CODE_SESSION_ID", None)
            else:
                os.environ["CLAUDE_CODE_SESSION_ID"] = prev
        # new_id must avoid ids used in ANY file, not just one
        other = session_file("other")
        append(other, {"id": "d00d", "type": "task", "what": "y", "ts": 1})
        orig = secrets.token_hex
        free = next(x for x in ("beef", "b33f", "f00d", "c0de") if x not in all_ids())
        draws = iter(["d00d", free])
        secrets.token_hex = lambda n=2: next(draws)
        try:
            assert new_id() == free, "new_id must skip an id used in any file"
        finally:
            secrets.token_hex = orig
        assert safe_project("a/b") == "a_b" and safe_project("x") == "x", "project separators sanitized"
        assert session_file("sub/dir").name.endswith("-sub_dir.jsonl"), "slash project does not crash"
        tid = add_term(f, "GUARD", "i", "t")
        try:
            update(tid, {"status": "done"})
            raise AssertionError("update on a term must be rejected")
        except SystemExit:
            pass
        assert "status" not in fold(f)[tid], "a rejected update must not touch the term"
        d1 = add_diagram(f, "Pipeline", "flowchart LR\n  a --> b")
        d2 = add_diagram(f, "pipeline", "flowchart LR\n  a --> c")
        assert d1 == d2, "diagram dedupe is case-insensitive on the title"
        assert fold(f)[d1]["mermaid"].endswith("a --> c"), \
            "re-recording a title REPLACES the source: a diagram is iterated on"
        try:
            update(d1, {"status": "done"})
            raise AssertionError("done on a diagram must be rejected")
        except SystemExit:
            pass
    from types import SimpleNamespace as NS
    assert with_extras({"a": 1}, NS(diagram="x", intuitive=None)) == {"a": 1, "diagram": "x"}
    assert with_extras({}, NS()) == {}, "absent flags write nothing"
    assert with_extras({}, NS(diagram="", intuitive="i")) == {"intuitive": "i"}, \
        "an empty string is not an extra - it must not land in the event"
    i4 = add_event("proj", {"type": "action", "status": "open", "background": "b",
                            "why": "w", "rec": "r"})
    update(i4, with_extras({}, NS(intuitive="plain words", diagram=None)))
    got = fold(session_file("proj"))[i4]
    assert got["intuitive"] == "plain words" and got["background"] == "b", \
        "an amend adds the field and touches nothing else"
    assert "progress" not in got, \
        "amending an ACTION must not invent a progress note it never had"
    # serve_refusal: pure, so both directions are testable without exec'ing uv
    assert serve_refusal({}, False) is None, "a human terminal is never refused"
    assert serve_refusal({"CLAUDE_CODE_SSE_PORT": "1"}, False) is None, \
        "the user's own VS Code terminal carries CLAUDE_CODE_* vars; only " \
        "CLAUDECODE itself marks a Claude session"
    msg = serve_refusal({"CLAUDECODE": "1"}, False)
    assert msg and "curl" in msg and "--force" in msg, \
        "the refusal must hand back the liveness check that actually works " \
        "(pgrep -f 'table-talk serve' never matches: execv renames the process)"
    assert serve_refusal({"CLAUDECODE": "1"}, True) is None, "--force overrides"
    print("ok")


def main():
    p = argparse.ArgumentParser(prog="table-talk", description=__doc__)
    p.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("action", help="record a decision needed from the user")
    a.add_argument("background")
    a.add_argument("--why", required=True)
    a.add_argument("--rec", required=True)
    a.add_argument("--project")
    a.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    a.add_argument("--intuitive", help="plain-English line: what this is and what is needed")

    t = sub.add_parser("task", help="record background work")
    t.add_argument("what")
    t.add_argument("--project")
    t.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    t.add_argument("--intuitive", help="plain-English line: what this job is doing")

    pr = sub.add_parser("progress", help="update progress on an item")
    pr.add_argument("id")
    pr.add_argument("text", nargs="?", help="progress note; omit to only amend --intuitive/--diagram")
    pr.add_argument("--diagram", help="add or replace the item's ASCII sketch")
    pr.add_argument("--intuitive", help="add or replace the item's plain-English line")
    pr.add_argument("--pct", type=int,
                    help="explicit completion 0-100; beats any number found in the text")

    d = sub.add_parser("done", help="mark an item done")
    d.add_argument("id")

    tm = sub.add_parser("term", help="record a technical term")
    tm.add_argument("term")
    tm.add_argument("--intuitive", required=True)
    tm.add_argument("--technical", required=True)
    tm.add_argument("--project")

    dg = sub.add_parser("diagram", help="record a mermaid diagram (the dashboard renders it)")
    dg.add_argument("mermaid", help="mermaid source, e.g. $'flowchart LR\\n  a --> b'")
    dg.add_argument("--title", required=True)
    dg.add_argument("--project")

    sh = sub.add_parser("show", help="dump folded state")
    sh.add_argument("project", nargs="?")
    sh.add_argument("--open", action="store_true",
                    help="only actions and jobs still outstanding")
    sh.add_argument("--mine", action="store_true",
                    help="only rows this session recorded (needs CLAUDE_CODE_SESSION_ID)")

    sv = sub.add_parser("serve", help="launch the dashboard")
    sv.add_argument("--port", type=int, help="default: server.port from the config (8731)")
    sv.add_argument("--force", action="store_true",
                    help="start even inside a Claude Code session")

    args = p.parse_args()
    if args.selftest:
        selftest()
    elif args.cmd == "action":
        print(add_event(args.project, with_extras(
            {"type": "action", "status": "open", "background": args.background,
             "why": args.why, "rec": args.rec}, args)))
    elif args.cmd == "task":
        print(add_event(args.project, with_extras(
            {"type": "task", "status": "open", "what": args.what}, args)))
    elif args.cmd == "progress":
        fields = with_extras({"progress": args.text} if args.text else {}, args)
        if args.pct is not None:        # 0 is a reading; with_extras drops falsy
            fields["pct"] = args.pct
        update(args.id, fields)
    elif args.cmd == "done":
        update(args.id, {"status": "done"})
    elif args.cmd == "term":
        print(add_term(session_file(args.project), args.term, args.intuitive, args.technical))
    elif args.cmd == "diagram":
        print(add_diagram(session_file(args.project), args.title, args.mermaid))
    elif args.cmd == "show":
        cmd_show(args.project, args.open, args.mine)
    elif args.cmd == "serve":
        cmd_serve(args.port, args.force)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
