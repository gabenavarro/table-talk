    # edit_hooks: this touches the user's ~/.claude/settings.json, which holds
    # their permissions, model choice and plugins. Every pin here is about not
    # destroying that file.
    keep = {"model": "opus", "permissions": {"allow": ["Bash"]},
            "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": []}]}}
    got, what = edit_hooks(keep, "PostToolUse", "/x/tt-beat")
    assert what == "installed" and got["model"] == "opus" \
        and got["permissions"] == {"allow": ["Bash"]} \
        and got["hooks"]["PreToolUse"] == keep["hooks"]["PreToolUse"], \
        "installing the hook must MERGE: a settings.json that lost the user's " \
        "permissions or their other hooks is a far worse bug than no heartbeat"
    assert keep["hooks"].get("PostToolUse") is None, \
        "edit_hooks must not mutate the dict it was handed - the caller " \
        "compares old to new to decide whether to write at all"
    assert got["hooks"]["PostToolUse"][0]["hooks"][0]["command"] == "/x/tt-beat" \
        and got["hooks"]["PostToolUse"][0]["hooks"][0]["type"] == "command" \
        and got["hooks"]["PostToolUse"][0]["matcher"] == "", \
        "the entry must match Claude Code's hook schema, or it is ignored " \
        "silently and the wall never shows a heartbeat"
    again, what = edit_hooks(got, "PostToolUse", "/x/tt-beat")
    assert what == "already installed" and again is got, \
        "re-running the installer must not stack duplicate hooks - every tool " \
        "call would then pay for the beat twice"
    other, what = edit_hooks(got, "PostToolUse", "/other/checkout/tt-beat")
    assert what == "installed" and len(other["hooks"]["PostToolUse"]) == 2, \
        "identity is the command path, so a second checkout installs its own"
    gone, what = edit_hooks(got, "PostToolUse", "/x/tt-beat", remove=True)
    assert what == "removed" and "PostToolUse" not in gone.get("hooks", {}) \
        and gone["model"] == "opus", \
        "--remove must take out only our entry and leave the rest of the file"
    assert "hooks" in gone and "PreToolUse" in gone["hooks"], \
        "removing our hook must not drop the user's OTHER hooks with it"
    empty, what = edit_hooks({}, "PostToolUse", "/x/tt-beat", remove=True)
    assert what == "not installed" and empty == {}, \
        "removing what was never installed must leave the file untouched"
    tidy, _ = edit_hooks(edit_hooks({}, "PostToolUse", "/x/tt-beat")[0], "PostToolUse", "/x/tt-beat", remove=True)
    assert tidy == {}, "removal leaves no empty scaffolding behind"
    # The write path itself, on a real file: a backup exists before the first
    # change, and a second run neither duplicates nor re-backs-up.
    with tempfile.TemporaryDirectory() as d:
        sp = Path(d) / "settings.json"
        sp.write_text(json.dumps({"model": "opus"}))
        cmd_install_hook(path=sp)
        first = json.loads(sp.read_text())
        backup = sp.with_suffix(".json.table-talk.bak")
        assert json.loads(backup.read_text()) == {"model": "opus"}, \
            "the pre-existing settings must be recoverable: this is the file " \
            "every Claude Code session reads, and we edit it during an install"
        cmd_install_hook(path=sp)
        assert json.loads(sp.read_text()) == first, "the second run is a no-op"
        assert not list(Path(d).glob("*tt-tmp")), \
            "the atomic temp file must not survive: a half-written " \
            "settings.json breaks every Claude Code session, not just this tool"
        # --remove is a REAL write, so it is what proves the backup is taken
        # once and never again; a no-op re-run would not exercise this at all.
        backup.write_text('{"marker": 1}')
        cmd_install_hook(remove=True, path=sp)
        assert json.loads(sp.read_text()) == {"model": "opus"}, \
            "--remove must return the file to what it was"
        assert json.loads(backup.read_text()) == {"marker": 1}, \
            "a later run must not overwrite the backup with hooked settings - " \
            "that would destroy the only copy of the user's original"
    assert 'jq -r' in (Path(__file__).resolve().parent / "tt-beat").read_text() \
        and 'shutil.which("jq")' in code, \
        "tt-beat parses its payload with jq, so installing the hook on a box " \
        "without jq must warn: otherwise it no-ops silently and the wall just " \
        "never shows a heartbeat, with nothing anywhere saying why"
    # edit_hooks is per-EVENT: one installer owns both hooks, and touching one
    # must not disturb the other.
    two, _ = edit_hooks(edit_hooks({}, "PostToolUse", "/x/tt-beat")[0],
                        "UserPromptSubmit", "/x/tt-ref")
    assert set(two["hooks"]) == {"PostToolUse", "UserPromptSubmit"}, \
        "the two hooks answer DIFFERENT events - collapsing them onto one " \
        "would mean the prompt hook never fires, or fires on every tool call"
    only, what = edit_hooks(two, "UserPromptSubmit", "/x/tt-ref", remove=True)
    assert what == "removed" and set(only["hooks"]) == {"PostToolUse"}, \
        "removing one hook must leave the other installed and working"
    assert edit_hooks(two, "UserPromptSubmit", "/x/tt-beat")[1] == "installed", \
        "identity is (event, command): the same command under a different " \
        "event is a different hook, not an already-installed one"

    assert dict(HOOKS) == {"PostToolUse": "tt-beat",
                           "UserPromptSubmit": "tt-ref"}, \
        "both hooks must ship: tt-beat alone is what shipped before, and " \
        "dropping tt-ref here disables the whole referenced-action check " \
        "with nothing else failing to say so"
    for _, _name in HOOKS:
        _h = Path(__file__).resolve().parent / _name
        assert _h.exists() and os.access(_h, os.X_OK), \
            f"{_name} must exist and be executable: Claude Code reports a " \
            f"missing hook command per tool call, in every project"

    # referenced_open: the half a log cannot see on its own.
    rst = {"aaaa": {"type": "action", "status": "open"},
           "bbbb": {"type": "action", "status": "done"},
           "cccc": {"type": "task", "status": "open"}}
    assert referenced_open(rst, {"aaaa", "bbbb", "cccc", "9999", "2026"}) == ["aaaa"], \
        "only a still-OPEN ACTION counts: a closed one needs nothing, a task " \
        "is not something the user answers, and a marker matching no id at " \
        "all is the stray 4-hex word the hook is allowed to record"
    assert referenced_open({}, set()) == [], "no markers, no noise"

    # warn_stale reports it, and still never reports the id just written.
    with tempfile.TemporaryDirectory() as td:
        keep2, DATA_DIR = DATA_DIR, Path(td)
        try:
            (DATA_DIR / "2026-01-01-proj.jsonl").write_text(json.dumps(
                {"id": "abcd", "type": "action", "status": "open"}) + "\n")
            (DATA_DIR / ".ref").mkdir()
            (DATA_DIR / ".ref" / "abcd").touch()
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("proj")
            assert "abcd" in err.getvalue() and "named by the user" in err.getvalue(), \
                "an action the user answered by id and the session never " \
                "closed must be named: this was two of the three rows found " \
                "stale on the wall, and nothing caught either of them"
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale("proj", skip_id="abcd")
            assert err.getvalue() == "", \
                "`done abcd` must not warn about abcd in the same breath - " \
                "the fix and the complaint would arrive together, every time"
        finally:
            DATA_DIR = keep2

    # project_of_id: progress and done resolve an id across EVERY project.
    with tempfile.TemporaryDirectory() as td:
        keep3, DATA_DIR = DATA_DIR, Path(td)
        try:
            (DATA_DIR / "2026-01-01-other-proj.jsonl").write_text(json.dumps(
                {"id": "7777", "type": "task", "status": "open",
                 "pct": 100}) + "\n")
            assert project_of_id("7777") == "other-proj", \
                "the item's own project must be recoverable from its file, or " \
                "a task set to 100% from a directory named something else is " \
                "never checked - the exact moment this warning exists for"
            assert project_of_id("nope") is None and project_of_id(None) is None, \
                "an unknown id falls back to the caller's project, not a crash"
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                warn_stale(project_of_id("7777"))
            assert "7777" in err.getvalue(), "and the nudge then actually fires"
        finally:
            DATA_DIR = keep3

    with tempfile.TemporaryDirectory() as td:
        u = Path(td) / "s.json"
        u.write_text("original")
        assert unchanged(u, "original"), "an untouched file must read as unchanged"
        u.write_text("someone else wrote this")
        assert not unchanged(u, "original"), \
            "a file rewritten since we read it must NOT read as unchanged: " \
            "Claude Code writes settings.json itself, and replacing it from a " \
            "stale copy silently discards the permission the user just granted"
        assert unchanged(Path(td) / "gone.json", ""), \
            "a file that never existed is not a concurrent write - the first " \
            "install on a clean machine must not refuse itself"
    assert "if not unchanged(p, raw):" in code, \
        "the guard must be CALLED before the replace; computed and ignored it " \
        "protects nothing"

    # cmd_install_hook hardening: it edits a file this tool does not own.
    with tempfile.TemporaryDirectory() as td:
        sp = Path(td) / "settings.json"
        sp.write_text(json.dumps({"model": "opus"}))
        (Path(td) / "settings.json.table-talk.bak").mkdir()
        try:
            cmd_install_hook(path=sp)
            raise AssertionError("expected a refusal")
        except SystemExit:
            pass
        assert json.loads(sp.read_text()) == {"model": "opus"}, \
            "a DIRECTORY at the backup path reads as 'already backed up': " \
            "without an is_file check the settings are rewritten with no " \
            "recoverable copy anywhere"
        for bad in ({"hooks": None}, {"hooks": "x"}, {"hooks": {"PostToolUse": "x"}},
                    {"hooks": {"PostToolUse": ["x"]}}):
            sp2 = Path(td) / "bad.json"
            sp2.write_text(json.dumps(bad))
            try:
                cmd_install_hook(path=sp2)
                raise AssertionError(f"expected a refusal for {bad}")
            except SystemExit:
                pass
            assert json.loads(sp2.read_text()) == bad, \
                "a hooks section of the wrong shape must REFUSE and leave the " \
                "file untouched; a traceback is not a refusal, and the " \
                "docstring promises this file is never overwritten blindly"
        real = Path(td) / "real.json"
        real.write_text(json.dumps({"model": "opus"}))
        link = Path(td) / "link.json"
        link.symlink_to(real)
        cmd_install_hook(path=link)
        assert link.is_symlink() and "hooks" in json.loads(real.read_text()), \
            "a symlinked settings.json (chezmoi, stow, any dotfile manager) " \
            "must be written THROUGH: os.replace swaps the link for a plain " \
            "file and leaves the tracked original silently stale"

    # tt-ref itself, run for real when jq is here. grep -o cannot produce
    # OVERLAPPING matches, so a hand-rolled separator group ate the boundary
    # the NEXT id needed: "a6d9 dcc5" recorded only a6d9, which is exactly the
    # message that answers two actions at once.
    if shutil.which("jq"):
        here_ = Path(__file__).resolve().parent

        def _hook(name, payload, td, env=None):
            e = {**os.environ, "TABLE_TALK_DIR": td}
            if env is not None:
                e = env
            r = subprocess.run([str(here_ / name)], input=json.dumps(payload),
                               text=True, capture_output=True, timeout=90, env=e)
            return r.returncode

        with tempfile.TemporaryDirectory() as td:
            _hook("tt-ref", {"prompt": "a6d9 dcc5; yes. not c65583d "
                             "nor deadbeefcafe", "cwd": "/x"}, td)
            got = {f.name for f in (Path(td) / ".ref").iterdir()}
            assert got == {"a6d9", "dcc5"}, \
                f"two ids in one message must BOTH be recorded, and hex " \
                f"inside a longer token must not be mistaken for an id " \
                f"(a git sha would flag constantly); got {sorted(got)}"

        with tempfile.TemporaryDirectory() as td:
            # A pasted hexdump is an ORDINARY message, not an attack.
            flood = " ".join(f"{n:04x}" for n in range(4000))
            t0 = time.time()
            _hook("tt-ref", {"prompt": flood}, td)
            took = time.time() - t0
            n = len(list((Path(td) / ".ref").iterdir()))
            assert n <= 32, \
                f"the ids recorded per message must be CAPPED: a pasted " \
                f"hexdump yields thousands, and UserPromptSubmit blocks the " \
                f"session until this returns; got {n}"
            assert took < 5, \
                f"and it must stay fast - one process per id took 3.5s for a " \
                f"154KB paste and 59s for a dense one; took {took:.1f}s"

        with tempfile.TemporaryDirectory() as td:
            # The sid becomes a filename; cut does not care what it cut.
            _hook("tt-beat", {"session_id": "../x-evil"}, td)
            assert not list(Path(td).glob("x*")), \
                "a session_id starting with ../ must write NOTHING: it " \
                "escaped .beat/ and dropped a file beside it"
            _hook("tt-beat", {"session_id": "0d2b330d-239e-4668"}, td)
            assert (Path(td) / ".beat" / "0d2b").exists(), \
                "and a real session id must still beat, or the wall goes dark"

        for _name in ("tt-ref", "tt-beat"):
            rc = _hook(_name, {"prompt": "a6d9", "session_id": "a6d9-x"}, "",
                       env={k: v for k, v in os.environ.items()
                            if k not in ("HOME", "TABLE_TALK_DIR")})
            assert rc == 0, \
                f"{_name} must exit 0 with HOME unset: under set -u a bare " \
                f"$HOME aborts NON-ZERO, and a hook that fails breaks the " \
                f"very session it exists to observe"

    # The user's actual question: the hook must be part of `./install.sh`, not a
    # README paragraph they have to notice.
    setup = (Path(__file__).resolve().parent.parent / "install.sh").read_text()
    assert '"$here/bin/table-talk" install-hook' in setup, \
        "install.sh must set the heartbeat hook up; left as a manual step, the " \
        "one feature that shows whether an agent is working is off for everyone"
    print("ok")


def main():
    p = argparse.ArgumentParser(prog="table-talk", description=__doc__)
    p.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("action", help="record a decision needed from the user")
    a.add_argument("background")
    a.add_argument("--why", required=True)
    a.add_argument("--rec", required=True)
    a.add_argument("--project")
    a.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    a.add_argument("--intuitive", help="plain-English line: what this is and what is needed")

    t = sub.add_parser("task", help="record background work")
    t.add_argument("what")
    t.add_argument("--project")
    t.add_argument("--diagram", help="small ASCII sketch drawn under the item (≤40 cols)")
    t.add_argument("--intuitive", help="plain-English line: what this job is doing")

    pr = sub.add_parser("progress", help="update progress on an item")
    pr.add_argument("id")
    pr.add_argument("text", nargs="?", help="progress note; omit to only amend --intuitive/--diagram")
    pr.add_argument("--diagram", help="add or replace the item's ASCII sketch")
    pr.add_argument("--intuitive", help="add or replace the item's plain-English line")
    pr.add_argument("--blocked-on", metavar="ACTION_ID",
                    help="this task cannot advance until that action is answered")
    pr.add_argument("--pct", type=int,
                    help="explicit completion 0-100; beats any number found in the text")

    d = sub.add_parser("done", help="mark an item done")
    d.add_argument("id")

    tm = sub.add_parser("term", help="record a technical term")
    tm.add_argument("term")
    tm.add_argument("--intuitive", required=True)
    tm.add_argument("--technical", required=True)
    tm.add_argument("--project")

    dg = sub.add_parser("diagram", help="record a mermaid diagram (the dashboard renders it)")
    dg.add_argument("mermaid", help="mermaid source, e.g. $'flowchart TD\\n  a --> b'")
    dg.add_argument("--title", required=True)
    dg.add_argument("--project")

    sh = sub.add_parser("show", help="dump folded state")
    sh.add_argument("project", nargs="?")
    sh.add_argument("--open", action="store_true",
                    help="only actions and jobs still outstanding")
    sh.add_argument("--mine", action="store_true",
                    help="only rows this session recorded (needs CLAUDE_CODE_SESSION_ID)")

    sub.add_parser("url", help="print the dashboard's URL, per the config")

    ih = sub.add_parser("install-hook",
                        help="add the heartbeat hook to ~/.claude/settings.json")
    ih.add_argument("--remove", action="store_true", help="take it out again")

    sv = sub.add_parser("serve", help="launch the dashboard")
    sv.add_argument("--port", type=int, help="default: server.port from the config (8731)")
    sv.add_argument("--force", action="store_true",
                    help="start even inside a Claude Code session")

    args = p.parse_args()
    if args.selftest:
        selftest()
    elif args.cmd == "action":
        print(add_event(args.project, with_extras(
            {"type": "action", "status": "open", "background": args.background,
             "why": args.why, "rec": args.rec}, args)))
    elif args.cmd == "task":
        print(add_event(args.project, with_extras(
            {"type": "task", "status": "open", "what": args.what}, args)))
    elif args.cmd == "progress":
        update(args.id, progress_fields(args))
    elif args.cmd == "done":
        update(args.id, {"status": "done"})
    elif args.cmd == "term":
        print(add_term(session_file(args.project), args.term, args.intuitive, args.technical))
    elif args.cmd == "diagram":
        print(add_diagram(session_file(args.project), args.title, args.mermaid))
    elif args.cmd == "show":
        cmd_show(args.project, args.open, args.mine)
    elif args.cmd == "install-hook":
        cmd_install_hook(args.remove)
    elif args.cmd == "url":
        print(dashboard_url())
    elif args.cmd == "serve":
        cmd_serve(args.port, args.force)
    else:
        p.print_help()

    if args.cmd in ("action", "task", "progress", "done", "term", "diagram"):
        # BOTH projects: the one the item lives in (progress/done resolve an id
        # across every project) and the one this session is reporting for. Using
        # only the item's silently skips the cwd's other stale rows; using only
        # the cwd's silently skips the item just touched. dict.fromkeys dedupes
        # the common case where they are the same.
        _id = getattr(args, "id", None)
        for _proj in dict.fromkeys([project_of_id(_id),
                                    safe_project(getattr(args, "project", None))]):
            if _proj:
                warn_stale(_proj, _id)


if __name__ == "__main__":
    main()
