        # #140: files roll over daily, so recording the SAME term/diagram
        # again on a LATER day must find the id already minted for it in an
        # OLDER file of the same project, but the new event still belongs to
        # TODAY's file - the session recording it must see its own row on its
        # own card, and the older file must keep its history undisturbed.
        old_term_file = Path(td) / "2020-01-01-dated.jsonl"
        old_term_file.touch()
        append(old_term_file, {"id": "fva1", "type": "term", "term": "FVA",
                               "intuitive": "old", "technical": "old t", "ts": 1})
        today_dated = session_file("dated")
        reused_term = add_term(today_dated, "fva", "new", "new t")
        assert reused_term == "fva1", \
            "recording the same term on a later day must reuse its id, so the merged glossary shows one row, not a duplicate (#140)"
        assert fold(today_dated)["fva1"]["intuitive"] == "new", \
            "the new event must land in TODAY's file, so the session that just recorded it sees it on its own card, not only in an old file it never touched (#140)"
        assert fold(old_term_file)["fva1"]["intuitive"] == "old", \
            "the OLDER file must be left untouched - it honestly recorded that definition then, and writing into it would falsify its recency (#140)"

        old_diagram_file = Path(td) / "2020-01-01-dgram.jsonl"
        old_diagram_file.touch()
