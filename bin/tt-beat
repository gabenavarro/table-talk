#!/bin/sh
# A Claude Code PostToolUse hook: record that this session is alive, right now.
#
# Runs on EVERY tool call, and Claude Code waits for every matching hook before
# the next turn, so this must stay cheap: one jq, one touch, no Python. It reads
# the hook payload on stdin (session_id is NOT available as an environment
# variable - verified against the docs) and touches a file named for the first
# four characters of the session, which is exactly the `sid` the CLI already
# stamps on every event, so the dashboard can join the two without a lookup.
#
# It can never break the session it reports on: every failure path exits 0, and
# nothing it writes is read by anything that must succeed.
set -u
# ${HOME:+...} yields nothing when HOME is unset; a bare $HOME under set -u
# would abort non-zero and break the session this hook exists to observe.
base="${TABLE_TALK_DIR:-${HOME:+$HOME/.local/share/table-talk}}"
[ -n "$base" ] || exit 0
dir="$base/.beat"
sid=$(jq -r '.session_id // empty' 2>/dev/null | cut -c1-4)
# The sid becomes a FILENAME, and cut does not care what it cut: a session_id
# of "../x" wrote a file a level up, outside .beat/ entirely. Four hex
# characters is what a session code is; anything else is not ours to write.
case $sid in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) exit 0 ;;
esac
mkdir -p "$dir" 2>/dev/null || exit 0
touch "$dir/$sid" 2>/dev/null || exit 0
exit 0
